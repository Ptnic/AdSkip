<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/backButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/rules_back"
                android:gravity="center"
                android:text="‹"
                android:textColor="@color/text"
                android:textSize="34sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="@string/rules_title"
                android:textColor="@color/text"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="3dp"
            android:text="@string/rules_desc"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/rulesCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/accent"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rules_packs_title"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/rules_packs_desc"
                android:textColor="@color/muted"
                android:textSize="11sp" />

            <Button
                android:id="@+id/loadRecommended"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_secondary"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:text="@string/rules_load_recommended"
                android:textAllCaps="false"
                android:textColor="@color/accent"
                android:textSize="13sp" />

            <Button
                android:id="@+id/loadAggressive"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_secondary"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:text="@string/rules_load_aggressive"
                android:textAllCaps="false"
                android:textColor="@color/warning"
                android:textSize="13sp" />

            <Button
                android:id="@+id/loadAllowlist"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_secondary"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:text="@string/rules_load_allowlist"
                android:textAllCaps="false"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView style="@style/AdSkip.SectionLabel" android:text="@string/rules_block_label" />

        <EditText
            android:id="@+id/blockRules"
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:background="@drawable/bg_input"
            android:gravity="top|start"
            android:hint="@string/rules_block_hint"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textNoSuggestions"
            android:padding="14dp"
            android:scrollbars="vertical"
            android:textColor="@color/text"
            android:textColorHint="@color/muted"
            android:textSize="13sp"
            android:typeface="monospace" />

        <Button
            android:id="@+id/importBlock"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_secondary"
            android:elevation="0dp"
            android:stateListAnimator="@null"
            android:text="@string/rules_import_block"
            android:textAllCaps="false"
            android:textColor="@color/accent"
            android:textSize="12sp" />

        <TextView style="@style/AdSkip.SectionLabel" android:text="@string/rules_allow_label" />

        <EditText
            android:id="@+id/allowRules"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:background="@drawable/bg_input"
            android:gravity="top|start"
            android:hint="@string/rules_allow_hint"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textNoSuggestions"
            android:padding="14dp"
            android:scrollbars="vertical"
            android:textColor="@color/text"
            android:textColorHint="@color/muted"
            android:textSize="13sp"
            android:typeface="monospace" />

        <Button
            android:id="@+id/importAllow"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_secondary"
            android:elevation="0dp"
            android:stateListAnimator="@null"
            android:text="@string/rules_import_allow"
            android:textAllCaps="false"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/saveRules"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_primary"
            android:elevation="0dp"
            android:stateListAnimator="@null"
            android:text="@string/rules_save"
            android:textAllCaps="false"
            android:textColor="#06141C"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
